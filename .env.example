# Google Gemini API Key (required)
# Get your API key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Logging level: minimal, detailed, debug
LOG_LEVEL=detailed

# Output directory for generated documents
OUTPUT_DIR=./output

# Maximum steps per game session (1-1000)
MAX_STEPS=100

# Play strategy: exploration, completion
PLAY_STRATEGY=exploration

# Video segment duration in seconds (2.0-5.0)
VIDEO_SEGMENT_DURATION=3.0

# ===== LangSmith Configuration =====
# Enable LangSmith tracing (true/false)
# Get your API key from: https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=game-design-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
